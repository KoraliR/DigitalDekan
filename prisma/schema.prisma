generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
}

enum RequestType {
  STUDY
  MILITARY
  APPOINTMENT
}

enum RequestStatus {
  NEW
  PROCESSING
  READY
  REJECTED
  CANCELLED
}

enum LessonType {
  LECTURE
  PRACTICE
  SEMINAR
  LAB
  TEST
  EXAM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum Funding {
  BUDGET
  CONTRACT
}

enum Gender {
  MALE
  FEMALE
}

enum AssessmentType {
  EXAM
  TEST
  COURSEWORK
}

model User {
  campusBookings CampusBooking[]
  campusSlots    CampusSlot[]
  bookLoans      CampusLoan[]
  bookHolds      CampusHold[]
  boardPosts     CampusPost[]
  boardReplies   CampusReply[]
  portfolio      CampusPortfolio[]
  campusPass     CampusPass?
  groupMarks     GroupAttendance[]
  id             String            @id @default(cuid())
  login          String            @unique
  name           String
  passwordHash   String
  role           Role              @default(STUDENT)
  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  notifications  Notification[]
  newsAuthors    News[]            @relation("NewsAuthor")
  audits         AuditEntry[]
  lessons        Lesson[]
  grades         Grade[]
  deadlines      Deadline[]
  requests       ServiceRequest[]
  attendances    Attendance[]
}

model Lesson {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  teacher          String
  room             String
  type             LessonType
  groups           String[]     @default([])
  campus           String?
  teachers         Json?
  originalStartsAt DateTime?
  originalEndsAt   DateTime?
  startsAt         DateTime
  endsAt           DateTime
  attendances      Attendance[]

  @@index([userId, startsAt])
}

model Attendance {
  id       String           @id @default(cuid())
  lessonId String
  userId   String
  status   AttendanceStatus
  lesson   Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
}

model Grade {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  score           Int
  threshold       Int
  term            Int
  assessment      AssessmentType?
  finalGrade      Int?
  passed          Boolean?
  practiceScore   Int?
  attendanceScore Int?
  controlScore    Int?

  @@unique([userId, title, term])
}

model Deadline {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  course      String
  dueAt       DateTime
  lessonId    String?
  completedAt DateTime?

  @@index([userId, dueAt])
}

model ServiceRequest {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      RequestType
  status    RequestStatus @default(NEW)
  number    String?       @unique
  comment   String?
  readyBy   DateTime?
  revision  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime?     @updatedAt

  @@index([userId, createdAt])
  @@index([createdAt])
}

model News {
  id          String   @id @default(cuid())
  title       String
  body        String
  kind        String   @default("news")
  audience    String   @default("all")
  createdById String?
  author      User?    @relation("NewsAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model LoginChallenge {
  id           String   @id
  userId       String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)

  @@index([expiresAt])
}

model StudyGroup {
  id       String           @id @default(cuid())
  name     String           @unique
  faculty  String
  course   Int
  students StudentProfile[]
  staff    StaffProfile[]   @relation("ScopedGroups")
  lessons  GroupLesson[]
}

model GroupLesson {
  comment          String?
  marks            GroupAttendance[]
  qr               AttendanceQr?
  groupId          String
  group            StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  id               String            @id @default(cuid())
  title            String
  teacher          String
  room             String
  type             LessonType
  campus           String?
  teachers         Json?
  originalStartsAt DateTime?
  originalEndsAt   DateTime?
  startsAt         DateTime
  endsAt           DateTime

  @@index([groupId, startsAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

model AuditEntry {
  groupId   String?
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  summary   String
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model StudentProfile {
  surnameStress Int?
  isMonitor     Boolean     @default(false)
  gender        Gender?
  userId        String      @id
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String?
  group         StudyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  birthDate     DateTime?
  studentId     String?     @unique
  institute     String?
  faculty       String?
  department    String?
  programCode   String?
  programName   String?
  course        Int?
  groupName     String?
  funding       Funding?
  phone         String?
  contactEmail  String?
  messengerUrl  String?

  @@index([groupId])
}

model StaffProfile {
  userId String       @id
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups StudyGroup[] @relation("ScopedGroups")
}

model GroupAttendance {
  lessonId String
  lesson   GroupLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   AttendanceStatus

  @@id([lessonId, userId])
}

model AttendanceQr {
  lessonId  String      @id
  lesson    GroupLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  token     String      @unique
  expiresAt DateTime
}

enum CampusSlotKind {
  CONSULTATION
  RETAKE
  ROOM
  COWORKING
  EQUIPMENT
  SPORT
}

model CampusSlot {
  id         String          @id @default(cuid())
  kind       CampusSlotKind
  title      String
  place      String
  startsAt   DateTime
  endsAt     DateTime
  capacity   Int
  staffId    String?
  staff      User?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  groupId    String?
  retakeTerm Int?
  bookings   CampusBooking[]

  @@unique([kind, place, startsAt])
  @@index([startsAt])
}

model CampusBooking {
  slotId   String
  slot     CampusSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attended Boolean    @default(false)

  @@id([slotId, userId])
  @@index([userId])
}

model CampusBook {
  id     String       @id @default(cuid())
  title  String       @unique
  author String
  isbn   String?
  loans  CampusLoan[]
  holds  CampusHold[]
}

model CampusLoan {
  bookId  String
  book    CampusBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt   DateTime
  renewed Boolean    @default(false)

  @@id([bookId, userId])
}

model CampusHold {
  bookId    String
  book      CampusBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([bookId, userId])
  @@index([bookId, createdAt])
}

model CampusPost {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  title        String
  body         String
  contactPhone String?
  contactEmail String?
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  closed       Boolean       @default(false)
  flagged      Boolean       @default(false)
  replies      CampusReply[]
}

model CampusReply {
  postId String
  post   CampusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  body   String

  @@id([postId, userId])
}

model CampusPortfolio {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  kind        String
  description String
  link        String?
  occurredAt  DateTime
  shared      Boolean  @default(false)

  @@index([userId])
}

model CampusPass {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest    String   @unique
  expiresAt DateTime
}

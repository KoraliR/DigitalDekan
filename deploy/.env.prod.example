# ============================================================================
# Шаблон production-окружения «Цифрового деканата».
# Скопируйте и заполните:  cp .env.prod.example .env.prod
# Файл deploy/.env.prod в git НЕ коммитится (см. ../.gitignore).
# Формат: KEY=value без пробелов вокруг «=» и без кавычек.
# ============================================================================

# --- Домен и HTTPS ----------------------------------------------------------
# Домен, на который указывает DNS A-запись (IPv4; при наличии IPv6 — и AAAA).
# Без схемы, без слэша и без пробелов: только имя, например dekanat.university.ru
DOMAIN=dekanat.example.ru
# E-mail ACME-аккаунта Let's Encrypt — на него придут уведомления о сертификате.
ACME_EMAIL=admin@example.ru

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=dekanat
# Пароль БД. ВАЖНО: он подставляется в DATABASE_URL, поэтому используйте только
# URL-безопасные символы (hex):  openssl rand -hex 24
POSTGRES_PASSWORD=__СГЕНЕРИРУЙТЕ__openssl_rand_-hex_24
POSTGRES_DB=dekanat

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Секрет подписи JWT-сессий, минимум 32 случайных байта:
#   openssl rand -base64 32
# Смена секрета разлогинивает всех пользователей.
AUTH_SECRET=__СГЕНЕРИРУЙТЕ__openssl_rand_-base64_32

# --- Демо-режим -------------------------------------------------------------
# ВАЖНО: в этом прототипе вход возможен ТОЛЬКО при DEMO_2FA_ENABLED=true —
# после пароля приложение показывает учебный шестизначный код на экране.
# При false Auth.js Credentials-провайдер отказывает во входе (никто не войдёт).
DEMO_2FA_ENABLED=true
# Пароль демо-аккаунтов (создаются `npm run db:accounts` / `db:seed`).
# Минимум 10 символов, не больше 72 байт; латиница, цифры и дефис — без сюрпризов.
DEMO_ACCOUNT_PASSWORD=dekanat-2026

# --- Прочее -----------------------------------------------------------------
# Часовой пояс контейнеров (расписание, даты, логи).
TZ=Europe/Moscow

# Первоначальный порядок заполнения:
#   1) DOMAIN и ACME_EMAIL — домен и почта;
#   2) POSTGRES_PASSWORD — openssl rand -hex 24;
#   3) AUTH_SECRET — openssl rand -base64 32;
#   4) DEMO_2FA_ENABLED/DEMO_ACCOUNT_PASSWORD — по необходимости;
#   5) права на файл: chmod 600 .env.prod.

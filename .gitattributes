# Git-атрибуты: артефакты для Linux/Docker должны иметь LF независимо от core.autocrlf.
# Иначе после checkout на Windows скрипты deploy/*.sh получат CRLF и не запустятся на сервере.

*.sh          text eol=lf
Dockerfile    text eol=lf
Caddyfile     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.mjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.prisma      text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.csv         text eol=lf
*.example     text eol=lf

# Готовые бинарные артефакты не считаем текстом (нет diff, корректное хранение).
*.xlsx        binary
*.dump        binary
